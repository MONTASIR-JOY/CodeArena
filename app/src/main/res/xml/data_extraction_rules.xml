<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for CodeArena: preserve SharedPreferences and Room database on Android 12+ (API 31+) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
