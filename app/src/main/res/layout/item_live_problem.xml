<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.CodeArena.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLiveIndex"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_tag"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textColor="@color/primary"
            android:textSize="16sp"
            tools:text="A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLiveName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="Watermelon" />

            <TextView
                android:id="@+id/tvLiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="Not attempted" />

            <TextView
                android:id="@+id/tvLiveSpent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-mono"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Focus time 05:12" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFocus"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Focus"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnOpen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open problem on Codeforces"
            android:src="@drawable/ic_open_in_new"
            app:tint="@color/primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
