<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCses"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary_dark"
        app:subtitle="219 Benchmark Problems • Antti Laaksonen"
        app:subtitleTextColor="@color/text_muted_dark"
        app:title="CSES Problem Set"
        app:titleTextColor="@color/text_primary_dark" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCsesSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search CSES tasks (name, task #, keyword)..."
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCsesSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CSES Progress Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeArena.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_logo_cses" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="CSES Solved Progress"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCsesProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            tools:text="15%" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCses"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        app:indicatorColor="@color/primary"
                        app:trackColor="@color/surface_dark"
                        app:trackCornerRadius="4dp"
                        tools:progress="15" />

                    <TextView
                        android:id="@+id/tvCsesProgressDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"
                        tools:text="33 of 219 tasks completed" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Filter Chips (Defaults to Unsolved Only) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="Filter by Solved Status"
                android:textColor="@color/text_primary_dark"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCsesStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCsesUnsolvedOnly"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Unsolved Only" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCsesSolvedOnly"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solved Only" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCsesAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All (219)" />
            </com.google.android.material.chip.ChipGroup>

            <!-- CSES Categories Header & Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Category"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCsesResultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    tools:text="186 tasks" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCsesCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All Categories (219)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatIntro"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Introductory (24)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatSortSearch"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sorting &amp; Searching (35)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatDP"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dynamic Programming (19)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatGraph"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Graph Algorithms (36)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatRange"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Range Queries (19)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatTree"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tree Algorithms (16)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatMath"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mathematics (31)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatString"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="String Algorithms (17)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatGeom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geometry (16)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatAdvanced"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Advanced Techniques (24)" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Tasks RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_catalog" />

            <!-- Load More Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadMoreCses"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="Load More Tasks"
                android:visibility="gone"
                app:cornerRadius="8dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvCsesEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="No CSES tasks match your filters."
                android:textColor="@color/text_muted_dark"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

