<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llDayCell"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_margin="1dp"
    android:background="@drawable/bg_tag_chip"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="2dp">

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="14" />

    <!-- Indicator Dots Row -->
    <LinearLayout
        android:id="@+id/llDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dotContest"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/bg_circle_dot"
            android:backgroundTint="@color/primary_blue"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:id="@+id/dotUpsolve"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/bg_circle_dot"
            android:backgroundTint="@color/verdict_pending"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:id="@+id/dotSolve"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="1dp"
            android:background="@drawable/bg_circle_dot"
            android:backgroundTint="@color/secondary"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
