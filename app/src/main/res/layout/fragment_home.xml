<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Daily Target & Stats Hero Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Daily Practice Target"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Circular Progress Ring Reused as Daily Target Ring -->
                    <com.kuet.codearena.ui.widget.CircularTimerView
                        android:id="@+id/circularDailyTarget"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_marginVertical="12dp"
                        app:centerSubtext="Target"
                        app:centerText="0 / 2"
                        app:maxProgress="2"
                        app:progress="0"
                        app:progressColor="@color/secondary"
                        app:ringColor="@color/gray_200"
                        app:strokeWidth="12dp"
                        app:textColor="?android:attr/textColorPrimary"
                        app:textSize="22sp" />

                    <!-- Streaks & Rating Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Current Streak -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCurrentStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_flame"
                                android:drawablePadding="4dp"
                                android:textColor="@color/verdict_pending"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                app:drawableTint="@color/verdict_pending"
                                tools:text="5 Days" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Streak"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Longest Streak -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLongestStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary_blue"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="14 Days" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Longest Streak"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Practice Rating -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHomePracticeRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/secondary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="940" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Practice Rating"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Upsolve Queue Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Spaced Upsolve Queue"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvUpsolveCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="3 Due" />

            </LinearLayout>

            <!-- Upsolve RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHomeUpsolves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyUpsolve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/no_upsolve_items"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Recent Runs Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Recent Virtual Contest Runs"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <!-- Recent Runs RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentRuns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyRuns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="No virtual runs recorded yet. Start one from the Contests tab!"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
