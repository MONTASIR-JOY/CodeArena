<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Toolbar (Always pinned at the top) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCatalog"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="Back"
        app:title="Codeforces Catalog"
        app:titleTextColor="@color/text_primary_dark" />

    <!-- Full-page unified smooth scrolling: touching ANYWHERE (upper or lower) scrolls effortlessly -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCatalog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Study Progress Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CodeArena.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/verdict_ok" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="Catalog Study Progress"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCatalogProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/verdict_ok"
                            android:textSize="14sp"
                            tools:text="12%" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressCatalog"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        app:indicatorColor="@color/verdict_ok"
                        app:trackColor="@color/stroke_dark"
                        app:trackCornerRadius="4dp"
                        tools:progress="12" />

                    <TextView
                        android:id="@+id/tvCatalogProgressDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="12sp"
                        tools:text="45 of 381 tutorials marked as read" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search box -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_muted_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCatalogSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search tutorials, algorithms, authors..."
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Read / Unread Status Filter -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupReadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReadAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="All Tutorials" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReadUnreadOnly"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unread Only" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReadCompletedOnly"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read / Completed" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 7 Main Blocks Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Core Catalog Blocks"
                android:textColor="@color/text_primary_dark"
                android:textSize="13sp" />

            <!-- Main Blocks Scrollable Horizontal Chip Group -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMainBlocks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockGeneral"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="1. General Advice (21)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockDS"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Data Structures (63)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockDP"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Dynamic Programming (13)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockGraphs"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Graphs &amp; Trees (51)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockMath"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Mathematics (112)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockStringsGeom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6. Strings &amp; Geometry (60)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockMeta"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7. Languages &amp; Meta (61)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBlockAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Blocks (381)" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Sub-Category / Block Subtopics -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSubCategoryLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Sub-Blocks"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvResultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    tools:text="21 tutorials" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSubBlocks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- RecyclerView of Tutorials -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_catalog" />

            <!-- Load More Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadMore"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="Load More Tutorials"
                android:visibility="gone"
                app:cornerRadius="8dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvCatalogEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="No tutorials match your filters."
                android:textColor="@color/text_muted_dark"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
