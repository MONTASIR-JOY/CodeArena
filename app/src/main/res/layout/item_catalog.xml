<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.CodeArena.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top tags row: Section, Topic, Level, and Read Status Checkbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCatalogSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_tag"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="@color/tertiary"
                android:textSize="10sp"
                tools:text="General advice" />

            <TextView
                android:id="@+id/tvCatalogCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/primary"
                android:textSize="11sp"
                tools:text="How to come up with the solution" />

            <TextView
                android:id="@+id/tvCatalogLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_muted_dark"
                android:textSize="11sp"
                tools:text="· Intermediate" />

            <!-- Read / Unread toggle button -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbCatalogRead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Read"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp"
                app:buttonTint="@color/verdict_ok" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvCatalogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_primary_dark"
            android:textSize="16sp"
            tools:text="How to Come Up with the Solution" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvCatalogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp"
            tools:text="Step-by-step thinking process: analyzing constraints, finding invariants, small examples, and reducing problems." />

        <!-- Author / Footer row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCatalogAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_muted_dark"
                android:textSize="12sp"
                tools:text="By Errichto · Blog #68953" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Read Tutorial →"
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
