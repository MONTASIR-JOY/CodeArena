<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke_light"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvUpsolveIndex"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_tag_chip"
            android:gravity="center"
            android:textColor="@color/primary_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="C" />

        <TextView
            android:id="@+id/tvUpsolveName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/tvUpsolveRating"
            app:layout_constraintStart_toEndOf="@id/tvUpsolveIndex"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Hamiltonian Wall" />

        <TextView
            android:id="@+id/tvUpsolveRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1400" />

        <TextView
            android:id="@+id/tvUpsolveIntervalBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_tag_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tvUpsolveIndex"
            app:layout_constraintTop_toBottomOf="@id/tvUpsolveName"
            tools:text="Day 3 Review" />

        <TextView
            android:id="@+id/tvUpsolveDue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/tvUpsolveIntervalBadge"
            app:layout_constraintEnd_toStartOf="@id/btnVerifyAc"
            app:layout_constraintStart_toEndOf="@id/tvUpsolveIntervalBadge"
            app:layout_constraintTop_toTopOf="@id/tvUpsolveIntervalBadge"
            tools:text="Due Today" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerifyAc"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="@string/verify_ac"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_check"
            app:iconSize="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUpsolveRating" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
