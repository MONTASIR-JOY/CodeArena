<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top App Bar / Title -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarCalendar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:title="Contest Calendar"
        app:titleTextColor="@color/text_primary_dark" />

    <!-- Swipe Refresh Layout -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshCalendar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Month Navigation Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <!-- Prev Month Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevMonth"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconTint="@color/text_primary_dark" />

                    <!-- Month & Year Title -->
                    <TextView
                        android:id="@+id/tvMonthYear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="18sp"
                        tools:text="November 2026" />

                    <!-- Next Month Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextMonth"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconTint="@color/text_primary_dark" />

                    <!-- Today Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToday"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Today"
                        android:textSize="12sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Platform Filter Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCalendar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:checkedChip="@id/chipCalAll"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Platforms" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalCF"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Codeforces" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalLC"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LeetCode" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalCC"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CodeChef" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalAC"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AtCoder" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalHR"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HackerRank" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Calendar Card Container -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CodeArena.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/stroke_dark"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Days of Week Header Row (MON to SUN) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:background="@color/surface_elevated_dark"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/CalendarDayHeader"
                                android:text="MON" />

                            <TextView
                                style="@style/CalendarDayHeader"
                                android:text="TUE" />

                            <TextView
                                style="@style/CalendarDayHeader"
                                android:text="WED" />

                            <TextView
                                style="@style/CalendarDayHeader"
                                android:text="THU" />

                            <TextView
                                style="@style/CalendarDayHeader"
                                android:text="FRI" />

                            <TextView
                                style="@style/CalendarDayHeader"
                                android:text="SAT" />

                            <TextView
                                style="@style/CalendarDayHeader"
                                android:text="SUN" />
                        </LinearLayout>

                        <!-- Month Days Grid -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCalendarGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Selected Day Contests Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tvSelectedDayTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="16sp"
                        tools:text="Contests on Saturday, Nov 7" />

                    <TextView
                        android:id="@+id/tvSelectedDaySubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted_dark"
                        android:textSize="12sp"
                        tools:text="2 contests scheduled on this day" />
                </LinearLayout>

                <!-- Empty State for Selected Day -->
                <TextView
                    android:id="@+id/tvDayEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_chip_tag"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="No contests scheduled for this date"
                    android:textColor="@color/text_muted_dark"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Selected Day Contests List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDayContests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>

